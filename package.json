{
  "name": "lx-music-netease",
  "version": "0.1.0",
  "private": true,
  "description": "LX Music 网易云音乐风格 UI 重制版 — 共享内核 Monorepo",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
