# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'LXMusic' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'LXMusicTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react-native-track-player 的 podspec 里写的是 s.swift_version = "4.2"
    # （它的依赖 SwiftAudioEx 也是）。Swift 4 语言模式编译出来的目标文件会带上
    # __swift_FORCE_LOAD_$_swiftCompatibility56 这个 autolink 符号，而新版 Xcode
    # 的工具链里已经没有对应的 libswiftCompatibility56，链接阶段直接报：
    #   Undefined symbols for architecture arm64:
    #     "__swift_FORCE_LOAD_$_swiftCompatibility56", referenced from:
    #         ... in libSwiftAudioEx.a[3](AudioItem.o)
    #         ... in libreact-native-track-player.a[4](Capabilities.o)
    # 把所有 pod 的 Swift 语言模式提到 5.0，编译器就不再产生这个符号。
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['SWIFT_VERSION'] = '5.0'
      end
    end

    # react-native-track-player 的 podspec 声明 swift_version 4.2，编译出的 .o 会
    # autolink 到 libswiftCompatibility56（链接命令里是 -lswiftCompatibility56）。
    # 这个 .a 只存在于 **工具链** 目录：
    #   $(TOOLCHAIN_DIR)/usr/lib/swift/iphoneos/libswiftCompatibility56.a
    # 而 SDK 目录 $(SDKROOT)/usr/lib/swift/ 下只有 .tbd 桩文件。
    # 本 app target 是纯 Objective-C（AppDelegate.mm / main.m，没有任何 .swift），
    # Xcode 因此判定「这不是 Swift target」，不把工具链的 swift 目录加进
    # LIBRARY_SEARCH_PATHS，链接器自然找不到 -lswiftCompatibility56。
    # 这里直接给 user project 的每个 target 补上该目录（保留 $(inherited)）。
    swift_compat_dir = '$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)'
    installer.aggregate_targets.each do |aggregate_target|
      user_project = aggregate_target.user_project
      next if user_project.nil?
      user_project.native_targets.each do |native_target|
        native_target.build_configurations.each do |build_config|
          paths = build_config.build_settings['LIBRARY_SEARCH_PATHS'] || []
          paths = [paths] if paths.is_a?(String)
          paths = paths.dup
          paths << '$(inherited)' unless paths.include?('$(inherited)')
          paths << swift_compat_dir unless paths.include?(swift_compat_dir)
          build_config.build_settings['LIBRARY_SEARCH_PATHS'] = paths
        end
      end
      user_project.save
    end
  end
end
