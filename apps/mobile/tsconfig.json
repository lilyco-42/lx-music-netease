{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "types": [],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@lxmn/core": [
        "../../packages/core/src/index.ts"
      ],
      "@lxmn/platform-mobile": [
        "../../packages/platform-mobile/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "App.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ]
}
